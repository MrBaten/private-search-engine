# Copy to .env (run.sh does this and generates the secret automatically).
# .env is gitignored and must never be committed.

# Public URL of the instance, WITH trailing slash.
#   Standalone stack (this directory):   http://localhost:8080/
#   Root stack behind Nginx sub-path:    http://localhost/searxng/
# Overrides server.base_url in settings.yml.
SEARXNG_BASE_URL=http://localhost:8080/

# Random secret for the instance. Replace "change-me" with:  openssl rand -hex 32
# Overrides server.secret_key in settings.yml.
SEARXNG_SECRET=change-me
