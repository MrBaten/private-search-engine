# Root .env (optional) — read by `docker compose` for variable substitution.
# Copy to .env and set your public URL when deploying behind a real domain.
# The trailing slash matters.
SEARXNG_BASE_URL=http://localhost/searxng/

# Optional search API keys for the custom engine (leave empty to skip).
# Brave Search API (paid, includes monthly free credits):
#   https://api-dashboard.search.brave.com/  -> Brave then uses the official API
BRAVE_API_KEY=
# Marginalia Search API: free non-commercial key by emailing the operator, see
#   https://about.marginalia-search.com/article/api/  (empty = shared "public" key)
MARGINALIA_API_KEY=
